datasets/
data/
# Audio and compressed archive files anywhere in the repo
*.tar.gz
*.tar
*.zip
*.gz
*.wav
*.mp3
*.flac
*.npy
*.npz

# =====================================================================
# 2. Experiment Outputs, Model Checkpoints & Logs
# =====================================================================
outputs/
logs/
*.pth
*.pt
*.ckpt
*.bin
*.onnx

# =====================================================================
